<%-include("navbar.ejs")%>

<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/admin/dashboard.css">
</head>
<body>

 <div class="dashboard">

    <h1>Dashboard</h1>

    <div class="cards">
        <div class="card">
            <h3>Total Products</h3>
            <p><%= total_products %></p>
        </div>

        <div class="card">
            <h3>Total Categories</h3>
            <p><%= total_categories %></p>
        </div>

        <div class="card">
            <h3>Total Orders</h3>
            <p><%= total_orders %></p>
        </div>

        <div class="card">
            <h3>Pending Orders</h3>
            <p><%= pending_orders %></p>
        </div>
    </div>

    <h2>Recent Orders</h2>

    <table class="dashboard-table">
        <tr>
            <th>Order ID</th>
            <th>Name</th>
            <th>Amount</th>
            <th>Status</th>
        </tr>

        

       <% recent_orders.forEach(function(o){ %>
       <tr>
            <td><%= o.order_id %></td>
            <td><%= o.customer_name %></td>
            <td>₹<%= o.order_amount %></td>
            <td>
                <span class="status <%= o.order_status %>">
                    <%= o.order_status %>
                </span>
            </td>
        </tr>
    <% }) %>



    </table>

</div>



</body>


<style>
    .dashboard {
    padding: 20px;
}

.cards {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
}

.card {
    flex: 1;
    background: white;
    padding: 20px;
    border-radius: 10px;
    text-align: center;
    box-shadow: 0 0 10px #ddd;
}

.card h3 {
    color: gray;
    font-size: 16px;
}

.card p {
    font-size: 30px;
    margin: 10px 0 0;
    color: #2ecc71;
}

.dashboard-table {
    width: 100%;
    background: white;
    border-collapse: collapse;
    box-shadow: 0 0 10px #ddd;
}

.dashboard-table th {
    background: #2ecc71;
    color: white;
    padding: 10px;
}

.dashboard-table td {
    padding: 10px;
    text-align: center;
    border-bottom: 1px solid #ddd;
}

/* Order Status colors */
.status.pending { color: orange; font-weight: bold; }
.status.delivered { color: green; font-weight: bold; }
.status.cancelled { color: red; font-weight: bold; }
.status.rejected { color: darkred; font-weight: bold; }
.status.returned { color: blue; font-weight: bold; }

</style>
<a href="/admin/logout" class="btn btn-danger " style="margin-left: 20px;">Logout</a>

</html>








<%-include("footer.ejs")%>