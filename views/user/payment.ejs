<!DOCTYPE html>
<html>
<head>
  <title>Payment</title>
</head>
<body>

<button id="rzp-button1" class="btn btn-dark">
  Pay Now
</button>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
  var options = {
    key: "rzp_test_bpN3aN81Oaf8Mo",
    amount: "<%= data[0].order_amount * 100 %>",
    currency: "INR",
    name: "My Ecommerce",
    description: "Order Payment",

    // callback_url: "http://localhost:3000/check_payment/<%= data[0].order_id %>",
    callback_url: "https://ecommerce-nodejs-mysql.onrender.com/check_payment/<%= data[0].order_id %>",

    redirect: true,

    prefill: {
      name: "<%= data[0].customer_name %>",
      contact: "<%= data[0].customer_mobile %>"
    },

    theme: {
      color: "#0d6efd"
    }
  };

  var rzp1 = new Razorpay(options);
  document.getElementById("rzp-button1").onclick = function (e) {
    rzp1.open();
    e.preventDefault();
  };
</script>

</body>
</html>
